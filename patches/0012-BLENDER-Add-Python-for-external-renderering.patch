From d4389477f95e6561c30c9e982e230a3ae53e4a89 Mon Sep 17 00:00:00 2001
From: Bart van der Braak <bart@blender.org>
Date: Wed, 4 Dec 2024 15:29:10 +0100
Subject: [PATCH 12/19] BLENDER: Add Python for external renderering

To be used for RestructuredText rendering using Sphinx to HTML.

See: https://projects.blender.org/infrastructure/gitea-custom/src/branch/main/sphinx#deployment
---
 Dockerfile.rootless | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/Dockerfile.rootless b/Dockerfile.rootless
index e83c1af33b..ebca19ca5b 100644
--- a/Dockerfile.rootless
+++ b/Dockerfile.rootless
@@ -55,6 +55,11 @@ RUN apk --no-cache add \
     openssh-keygen \
     && rm -rf /var/cache/apk/*
 
+# External renderers
+RUN apk --no-cache add \
+    python3-dev \
+    && rm -rf /var/cache/apk/*
+
 RUN addgroup \
     -S -g 1000 \
     git && \
